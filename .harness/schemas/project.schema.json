{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-development-harness:project:1",
  "title": "Development Harness project profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "stacks", "checks"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "stacks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "rules"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "rules": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["web", "typescript", "nextjs", "php", "laravel", "go", "python", "rust", "sql", "csharp", "unity", "godot", "github-actions"]
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "required"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "stage": { "enum": ["lint", "format", "typecheck", "test", "build", "security"] },
          "required": { "type": "boolean" },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "cwd": { "type": "string", "minLength": 1 },
          "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
          "skipReason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protectedBranches": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "secretPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "secretPathExceptions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "protectedPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
